[Unit]
Description=PrivaTube web app
After=network-online.target
Wants=network-online.target

[Service]
User=privatube
Group=privatube
EnvironmentFile=/etc/privatube/env
ExecStart=/opt/privatube/venv/bin/uvicorn privatube.web:app --host 127.0.0.1 --port 8000 --no-server-header --no-access-log
Restart=always
RestartSec=3
MemoryMax=300M
# hardening
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/privatube
UMask=0027
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
