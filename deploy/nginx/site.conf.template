# Generated by deploy/install.sh from site.conf.template; keep mode 0640 (contains the media secret).
limit_req_zone $binary_remote_addr zone=tt_auth:10m rate=10r/m;

server {
    listen __HTTPS_PORT__ ssl;
    listen [::]:__HTTPS_PORT__ ssl;
    http2 on;
    server_name __APP_HOST__;
    ssl_certificate     /etc/letsencrypt/live/__APP_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__APP_HOST__/privkey.pem;
    # __REALIP__
    server_tokens off;
    client_max_body_size 1m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    ssl_session_cache shared:tt_app_ssl:5m;   # returning visitors skip the full TLS handshake
    ssl_session_timeout 1d;
    keepalive_timeout 600s;                   # fewer new connections between page views
    gzip on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json application/manifest+json image/svg+xml;

    # Videos, thumbnails, channel pictures: only with a valid, expiring signature from the app.
    location /m/ {
        secure_link $arg_s,$arg_e;
        secure_link_md5 "$secure_link_expires$uri$arg_u __SECRET__";
        if ($secure_link = "")  { return 403; }
        if ($secure_link = "0") { return 410; }
        location ~ /\. { return 404; }
        alias /var/lib/privatube/media/;
        add_header Cache-Control "private, max-age=3600";
        add_header Content-Disposition "inline";
        add_header X-Content-Type-Options "nosniff";
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    }
    location ~ ^/(login|code)$ {
        limit_req zone=tt_auth burst=5 nodelay;
        include /etc/nginx/privatube-proxy.conf;
    }
    location / {
        include /etc/nginx/privatube-proxy.conf;
    }
}
