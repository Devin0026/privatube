# /etc/privatube/env  (install.sh creates it from this file with a random PT_MEDIA_SECRET
# and sets PT_SITE_URL; edit, then: sudo systemctl restart privatube-web privatube-worker)
PT_DATA_DIR=/var/lib/privatube
PT_SITE_URL=https://videos.example.com
# Signs every video/picture link; nginx checks it. Changing it invalidates open links only.
PT_MEDIA_SECRET=change-me
# YouTube blocks many datacenter IPv6 addresses ("Sign in to confirm you're not a bot").
PT_YTDLP_IPV4=1
# If YouTube still asks: cookies.txt of a spare Google account (upload it in Admin ->
# YouTube login; stored here, owned by privatube, mode 600, yt-dlp rewrites it).
#PT_YTDLP_COOKIES=/var/lib/privatube/cookies.txt
# Highest video quality by default (per channel/video it can be changed in admin).
PT_DEFAULT_HEIGHT=720
# Also list channels with titles in this language ("" = off), e.g. de, ja, zh-CN.
PT_TITLE_LANG=
# Subtitle languages to keep (comma-separated; human-made tracks first, else YouTube's).
PT_SUB_LANGS=en
# Downloads pause while the disk has less than this free.
PT_MIN_FREE_GB=2
# Database backups: one every N hours into /var/lib/privatube/backups, the last N kept.
PT_BACKUP_HOURS=24
PT_BACKUP_KEEP=14
PT_MAX_COMMENTS=300
PT_POLL_MINUTES=60
PT_PASSWORD_MAX_AGE_DAYS=182
# Devices signed in at once per account; a new sign-in signs out the least recently used.
PT_MAX_DEVICES=2
# Optional push alert for problems: a URL that accepts a POST with "title" and "desp"/"body"
# form fields (e.g. a Bark, ntfy-compatible or ServerChan URL). Empty = admin banner only.
#PT_ALERT_URL=
# Cache dirs for yt-dlp / deno (the services run with a read-only filesystem)
XDG_CACHE_HOME=/var/lib/privatube/cache
DENO_DIR=/var/lib/privatube/cache/deno
